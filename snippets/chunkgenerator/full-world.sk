# Full World Generation
# By ShaneBee

# This snippet shows off a world generator that is meant to resemble a similar terrain to Minecraft.
# It is fully customized.
# This is a work in progress.
# This snippet is not meant to be copy/pasted, its to show off some world generation techniques.
# This snippet uses several custom biomes.
# My good friend Claude helped me with some of this stuff.

# Requirements: SkBee, SkNoise, skript-reflect

on load:
	# Wait a tick to make sure generator is properly loaded
	# without this the spawn area doesn't generate properly (it's flat)
	wait 1 tick
	if world("world_test_world") is not loaded:
		set {_w} to world creator named "world_test_world"
		set chunk generator of {_w} to chunk generator with id "test_gen"
		load world from creator {_w}

options:
	seed: 234

on load:
	suppress variable save warning
	# 1 = Continental (large scale landmasses)
	set {-gen1} to new perlin generator with seed {@seed}
	set octaves of {-gen1} to 4
	set frequency of {-gen1} to 0.5
	set lacunarity of {-gen1} to 2.0
	set gain of {-gen1} to 0.5

	# 2 = Terrain (rolling hills)
	set {-gen2} to new perlin generator with seed ({@seed} + 1)
	set octaves of {-gen2} to 4
	set frequency of {-gen2} to 0.5
	set lacunarity of {-gen2} to 2.0
	set gain of {-gen2} to 0.5

	# 3 = Mountain (ridged peaks)
	set {-gen3} to new perlin generator with seed ({@seed} + 2)
	set octaves of {-gen3} to 3
	set frequency of {-gen3} to 0.5
	set lacunarity of {-gen3} to 2.2
	set gain of {-gen3} to 0.6

	# 4 = Biome (cellular)
	set {-gen4} to new cellular generator with seed {@seed}
	set octaves of {-gen4} to 3
	set frequency of {-gen4} to 0.015
	set lacunarity of {-gen4} to 2.0
	set cellular distance function of {-gen4} to hybrid
	set cellular return type of {-gen4} to cellvalue
	set cellular jitter of {-gen4} to 1

	# 5 = Detail/roughness (small scale surface noise)
	set {-gen5} to new perlin generator with seed ({@seed} + 3)
	set octaves of {-gen5} to 3
	set frequency of {-gen5} to 0.5
	set lacunarity of {-gen5} to 2.0
	set gain of {-gen5} to 0.6

	# 6 = Domain warp (distorts continent shape for natural irregularity)
	set {-gen6} to new perlin generator with seed ({@seed} + 4)
	set octaves of {-gen6} to 2
	set frequency of {-gen6} to 0.5
	set lacunarity of {-gen6} to 2.0
	set gain of {-gen6} to 0.5

	# 7 = Temperature — large scale, slow varying, perlin
	set {-gen7} to new perlin generator with seed ({@seed} + 5)
	set octaves of {-gen7} to 4
	set frequency of {-gen7} to 0.5
	set lacunarity of {-gen7} to 2.0
	set gain of {-gen7} to 0.5

	# 8 = Humidity — large scale, independent from temperature
	set {-gen8} to new perlin generator with seed ({@seed} + 6)
	set octaves of {-gen8} to 4
	set frequency of {-gen8} to 0.5
	set lacunarity of {-gen8} to 2.0
	set gain of {-gen8} to 0.5

	# 9 = Erosion — large scale, determines flat vs hilly regions
	set {-gen9} to new perlin generator with seed ({@seed} + 7)
	set octaves of {-gen9} to 4
	set frequency of {-gen9} to 0.5
	set lacunarity of {-gen9} to 2.0
	set gain of {-gen9} to 0.5

	# 10 = Peaks and Valleys (weirdness/PV) — separates valleys from peaks
	set {-gen10} to new perlin generator with seed ({@seed} + 8)
	set octaves of {-gen10} to 4
	set frequency of {-gen10} to 0.5
	set lacunarity of {-gen10} to 2.0
	set gain of {-gen10} to 0.5

	# 11 = Roughness (fine scale surface variation)
	set {-gen11} to new perlin generator with seed ({@seed} + 9)
	set octaves of {-gen11} to 4
	set frequency of {-gen11} to 0.5
	set lacunarity of {-gen11} to 2.0
	set gain of {-gen11} to 0.6

# Continental noise: returns a value normalized to 0.0-1.0 with a curve applied
# Raw perlin at /2000 has a very gentle gradient — without a curve, most land
# sits in a narrow range near the shoreline and never reads as "inland".
#
# The curve works like this:
#   - Ocean (raw < 0): compressed into 0.0-0.5 (ocean takes up lower half)
#   - Land (raw >= 0): stretched into 0.5-1.0 with a power curve so that
#     even a small rise above the shoreline quickly reads as mid/far inland
#
# Shoreline = 0.5 exactly. Biome thresholds:
#   deep ocean < 0.20, shallow ocean 0.20-0.45, beach 0.45-0.55
#   near inland 0.55-0.68, mid inland 0.68-0.82, far inland > 0.82
expression continental noise at %number%, %number%:
	get:
		set {_x} to expr-1
		set {_z} to expr-2
		set {_warpX} to value of {-gen6} at ({_x} / 600), 0, ({_z} / 600)
		set {_warpZ} to value of {-gen6} at ({_x} / 600), ({_z} / 600), 0
		set {_warpStrength} to 120
		set {_warpedX} to ({_x} + {_warpX} * {_warpStrength}) / 2000
		set {_warpedZ} to ({_z} + {_warpZ} * {_warpStrength}) / 2000
		# Add land bias — positive = more land coverage
		set {_raw} to (value of {-gen1} at {_warpedX}, 0, {_warpedZ}) + 0.18
		# Apply asymmetric curve:
		# Ocean side (raw < 0): map -1..0 -> 0.0..0.5 linearly
		# Land side (raw >= 0): map 0..1 -> 0.5..1.0 with sqrt curve
		#   sqrt stretches values near 0 upward quickly
		#   e.g. raw=0.05 -> sqrt=0.22 -> cont=0.61 (near inland already)
		#   e.g. raw=0.20 -> sqrt=0.45 -> cont=0.72 (mid inland)
		if {_raw} < 0:
			set {_norm} to ({_raw} + 1) * 0.5
		else:
			if {_raw} > 1:
				set {_raw} to 1
			set {_norm} to 0.5 + (({_raw}) ^ 0.5) * 0.5
		return {_norm}

expression terrain noise at %number%, %number%:
	get:
		set {_x} to expr-1
		set {_z} to expr-2
		# Gentle domain warp using dedicated warp generator
		set {_wx} to value of {-gen6} at ({_x} / 400), 0, ({_z} / 400)
		set {_wz} to value of {-gen6} at ({_x} / 400), ({_z} / 400), 0
		set {_warpedX} to ({_x} + {_wx} * 60) / 90
		set {_warpedZ} to ({_z} + {_wz} * 60) / 90
		set {_t} to value of {-gen2} at {_warpedX}, 0, {_warpedZ}
		return {_t}

expression mountain noise at %number%, %number%:
	get:
		set {_x} to expr-1
		set {_z} to expr-2
		set {_m} to value of {-gen3} at ({_x} / 173), 0, ({_z} / 173)
		set {_ridged} to 1 - abs({_m})
		set {_ridged} to {_ridged} * {_ridged}
		return {_ridged}


# Smooth blend helper: clamps t between 0 and 1 with a smooth curve
# This avoids hard edges between biomes
expression smoothstep of %number% between %number% and %number%:
	get:
		set {_t} to ((expr-1) - (expr-2)) / ((expr-3) - (expr-2))
		if {_t} < 0:
			return 0
		if {_t} > 1:
			return 1
		# smoothstep formula: 3t^2 - 2t^3
		return {_t} * {_t} * (3 - 2 * {_t})

expression detail noise at %number%, %number%:
	get:
		set {_x} to expr-1
		set {_z} to expr-2
		set {_d} to value of {-gen5} at ({_x} / 28), 0, ({_z} / 28)
		return {_d}

expression erosion at %number%, %number%:
	get:
		set {_x} to expr-1
		set {_z} to expr-2
		# Sample terrain at a small offset to measure slope
		# The bigger the difference between samples, the less eroded (rougher)
		# The smaller the difference, the more eroded (flatter)
		set {_sample1} to terrain noise at {_x}, {_z}
		set {_sample2} to terrain noise at ({_x} + 8), ({_z} + 8)
		set {_diff} to {_sample1} - {_sample2}
		if {_diff} < 0:
			set {_diff} to {_diff} * -1
		# Invert so high value = high erosion (flat), low value = low erosion (rough)
		# diff will typically range 0 to ~0.3, so we normalize and invert
		set {_erosion} to 1 - ({_diff} * 5)
		if {_erosion} < 0:
			set {_erosion} to 0
		if {_erosion} > 1:
			set {_erosion} to 1
		return {_erosion}

# Temperature: very large scale (3000 block features) so climate zones are broad
# 0 = frozen, 0.25 = cold, 0.5 = temperate, 0.75 = warm, 1.0 = hot
expression temperature noise at %number%, %number%:
	get:
		set {_x} to expr-1
		set {_z} to expr-2
		set {_t} to value of {-gen7} at ({_x} / 3000), 0, ({_z} / 3000)
		set {_t} to ({_t} + 1) / 2
		return {_t}

# Humidity: very large scale (2500 block features), independent from temperature
# 0 = arid, 0.5 = moderate, 1.0 = wet
expression humidity noise at %number%, %number%:
	get:
		set {_x} to expr-1
		set {_z} to expr-2
		set {_h} to value of {-gen8} at ({_x} / 2500), 0, ({_z} / 2500)
		set {_h} to ({_h} + 1) / 2
		return {_h}

# Erosion: large scale (2500 block features) so flat/hilly regions are broad
# 0 = not eroded (mountainous/hilly), 1 = fully eroded (flat plains/swamps)
expression erosion noise at %number%, %number%:
	get:
		set {_x} to expr-1
		set {_z} to expr-2
		set {_e} to value of {-gen9} at ({_x} / 2500), 0, ({_z} / 2500)
		set {_e} to ({_e} + 1) / 2
		return {_e}

# Peaks and Valleys (PV): medium scale (800 block features)
# Ridged noise: 1.0 = sharp peak, 0.0 = valley bottom
# Used to separate valley floors (rivers/swamps) from hilltops/peaks
expression pv noise at %number%, %number%:
	get:
		set {_x} to expr-1
		set {_z} to expr-2
		set {_w} to value of {-gen10} at ({_x} / 800), 0, ({_z} / 800)
		# Fold into ridged: 1 at peaks, 0 at valleys
		set {_pv} to 1 - abs({_w})
		return {_pv}

expression block noise at %number%, %number%:
	get:
		set {_x} to expr-1
		set {_z} to expr-2

		set {_cont} to continental noise at {_x}, {_z}
		set {_terrain} to terrain noise at {_x}, {_z}
		set {_mountain} to mountain noise at {_x}, {_z}
		set {_detail} to detail noise at {_x}, {_z}

		# Mid layer
		set {_mid} to value of {-gen2} at (({_x} + 3371) / 45), 0, (({_z} + 1847) / 45)

		# Fine roughness
		set {_rough} to value of {-gen5} at ({_x} / 22), 0, ({_z} / 22)

		# Small hill layer — medium scale, always active on land
		set {_hills} to value of {-gen11} at ({_x} / 35), 0, ({_z} / 35)

		# Coastal variation — shoreline is now exactly 0.5
		set {_coastVar} to value of {-gen3} at (({_x} + 5531) / 250), 0, (({_z} + 2917) / 250)
		set {_coastVar} to ({_coastVar} + 1) / 2
		set {_coastLow} to 0.47 + {_coastVar} * 0.02
		set {_coastHigh} to 0.54 + {_coastVar} * 0.03
		set {_landAmt} to smoothstep of {_cont} between {_coastLow} and {_coastHigh}

		# Inland scale — 0.5 = shore, 1.0 = deep inland
		set {_inlandScale} to smoothstep of {_cont} between 0.55 and 0.85

		# --- TERRAIN SHAPE LAYERS ---

		# Rolling hills — coast has a base amplitude of 8, grows to 18 inland
		set {_terrainHeight} to {_terrain} * (8 + {_landAmt} * 10)

		# Mid bumps — coast has base 5, grows to 12 inland
		set {_midHeight} to {_mid} * (5 + {_landAmt} * 7)

		# Small hills — present everywhere on land
		set {_hillStrength} to smoothstep of {_cont} between 0.50 and 0.60
		set {_hillHeight} to {_hills} * 6 * {_hillStrength}

		# Roughness — surface texture
		set {_roughHeight} to {_rough} * 3

		# Detail — micro bumps
		set {_detailHeight} to {_detail} * 2

		# --- PLATEAU LAYER ---
		# Plateaus: take the terrain signal, flatten it using a soft-clamp
		# The abs+square reshape creates flat tops with steep edges
		set {_plateauRaw} to value of {-gen11} at (({_x} + 7213) / 130), 0, (({_z} + 3941) / 130)
		set {_plateauShape} to abs({_plateauRaw})
		# Soft-clip: values above 0.4 get compressed strongly (flat top effect)
		if {_plateauShape} > 0.4:
			set {_plateauShape} to 0.4 + ({_plateauShape} - 0.4) * 0.15
		# Only apply plateaus on land, stronger inland
		set {_plateauStrength} to smoothstep of {_cont} between 0.55 and 0.80
		set {_plateauHeight} to {_plateauShape} * {_plateauStrength} * 28

		# --- VALLEY LAYER ---
		# Valleys carve down — use abs of a noise, invert so low = carved
		set {_valleyRaw} to value of {-gen2} at (({_x} + 9241) / 80), 0, (({_z} + 4127) / 80)
		set {_valleyAbs} to abs({_valleyRaw})
		# Only carve where valleyAbs is small (near zero crossings = valley bottoms)
		set {_valleyCarve} to 1 - (smoothstep of {_valleyAbs} between 0 and 0.3)
		set {_valleyStrength} to smoothstep of {_landAmt} between 0.15 and 0.8
		set {_valleyDepth} to {_valleyCarve} * {_valleyStrength} * 14

		# --- BASE HEIGHT ---
		# Land needs to reliably sit above sea level (Y=63)
		# _landAmt * 16 ensures even coastal land clears the water
		# _inlandScale * 22 adds the gradual rise inland (plains -> hills -> highlands)
		set {_baseHeight} to {_landAmt} * 16 + {_inlandScale} * 22

		# --- MOUNTAINS ---
		# Mountains are rare — only appear at high inland scale and on certain peaks
		set {_mountainBlend} to smoothstep of {_inlandScale} between 0.6 and 1.0
		set {_mountainHeight} to {_mountain} * {_mountainBlend} * 55

		# Zero out all land layers in ocean (cont < 0.47 = below shoreline)
		if {_cont} < 0.47:
			set {_terrainHeight} to 0
			set {_midHeight} to 0
			set {_hillHeight} to 0
			set {_mountainHeight} to 0
			set {_roughHeight} to 0
			set {_detailHeight} to 0
			set {_plateauHeight} to 0
			set {_valleyDepth} to 0
			set {_baseHeight} to 0

		set {_landTotal} to 62 + {_baseHeight} + {_terrainHeight} + {_midHeight} + {_hillHeight} + {_roughHeight} + {_detailHeight} + {_plateauHeight} + {_mountainHeight} - {_valleyDepth}

		# Ocean depth — pulls floor down smoothly from shore (0.5) to deep ocean (0.0)
		if {_cont} < 0.50:
			set {_oceanDepth} to 1 - (smoothstep of {_cont} between 0.0 and 0.50)
			set {_depthPull} to {_oceanDepth} * 55
			if {_depthPull} > 40:
				set {_depthPull} to 40
			set {_landTotal} to {_landTotal} - {_depthPull}

		set {_result} to floor({_landTotal})
		if {_result} < 20:
			set {_result} to 20
		return {_result}

# ============================================================
# BIOME LOOKUP
# Mirrors Minecraft's 6-parameter system:
#   cont  = how far from coast (ocean -> beach -> near/mid/far inland)
#   erosion = flat (1.0) vs hilly/mountainous (0.0)
#   pv    = valley bottom (0.0) vs peak (1.0) — for rivers & peaks
#   temp  = 0 frozen -> 1 hot (5 bands)
#   humidity = 0 arid -> 1 wet (5 bands)
#
# Parameter bands used:
#   TEMP:     frozen <0.2, cold 0.2-0.4, temperate 0.4-0.6, warm 0.6-0.8, hot >0.8
#   HUMIDITY: arid <0.2, dry 0.2-0.4, moderate 0.4-0.6, wet 0.6-0.8, lush >0.8
#   EROSION:  low(mountain) <0.3, mid 0.3-0.6, high(flat) >0.6
#   PV:       valley <0.25, mid 0.25-0.75, peak >0.75
# ============================================================
expression noise biome with cont %number% and erosion %number% and pv %number% and temp %number% and humidity %number%:
	get:
		set {_cont} to expr-1
		set {_erosion} to expr-2
		set {_pv} to expr-3
		set {_temp} to expr-4
		set {_humidity} to expr-5

		# ==============================
		# DEEP OCEAN (cont < 0.20)
		# Shoreline = 0.5; deep ocean is well below
		# ==============================
		if {_cont} < 0.20:
			if {_temp} < 0.2:
				return minecraft:deep_frozen_ocean
			else if {_temp} < 0.4:
				return minecraft:deep_cold_ocean
			else if {_temp} < 0.6:
				return minecraft:deep_ocean
			else:
				return minecraft:deep_lukewarm_ocean

		# ==============================
		# SHALLOW OCEAN (cont 0.20-0.45)
		# ==============================
		else if {_cont} < 0.45:
			if {_temp} < 0.2:
				return minecraft:frozen_ocean
			else if {_temp} < 0.4:
				return minecraft:cold_ocean
			else if {_temp} < 0.6:
				return minecraft:ocean
			else if {_temp} < 0.8:
				return minecraft:lukewarm_ocean
			else:
				return minecraft:warm_ocean

		# ==============================
		# BEACH / COAST (cont 0.45-0.57)
		# Straddles the shoreline (0.5)
		# ==============================
		else if {_cont} < 0.57:
			# Stony shore on steep low-erosion coasts
			if {_erosion} < 0.3:
				return minecraft:stony_shore
			# Swampy coast: warm+wet with high erosion
			else if {_erosion} > 0.7:
				if {_temp} > 0.6:
					if {_humidity} > 0.6:
						return beer:swamp/dripleaf_swamp
			# Standard beach by temperature
			if {_temp} < 0.2:
				return beer:coast/frozen_beach
			else if {_temp} < 0.4:
				return beer:coast/coast
			else if {_temp} < 0.8:
				if {_humidity} < 0.4:
					return beer:coast/beachy_beach
				else:
					return beer:coast/palm_beach
			else:
				if {_humidity} < 0.4:
					return beer:coast/dry_coast
				else:
					return beer:coast/lush_coast

		# ==============================
		# NEAR INLAND (cont 0.57-0.70)
		# ==============================
		else if {_cont} < 0.70:
			# Valley floors — rivers and swamps
			if {_pv} < 0.25:
				if {_temp} < 0.2:
					return minecraft:frozen_river
				else if {_temp} > 0.6:
					if {_humidity} > 0.6:
						return beer:swamp/dripleaf_swamp
					else:
						return minecraft:river
				else:
					return minecraft:river
			# High erosion = flat land
			else if {_erosion} > 0.6:
				if {_temp} < 0.2:
					return minecraft:snowy_plains
				else if {_temp} < 0.4:
					if {_humidity} > 0.6:
						return minecraft:snowy_taiga
					else:
						return beer:plains/cold_plains
				else if {_temp} < 0.6:
					if {_humidity} < 0.4:
						return beer:plains/temperate_plains
					else if {_humidity} < 0.7:
						return minecraft:plains
					else:
						return beer:plains/lush_plains
				else if {_temp} < 0.8:
					if {_humidity} < 0.4:
						return beer:plains/dry_plains
					else if {_humidity} < 0.7:
						return minecraft:savanna
					else:
						return minecraft:swamp
				else:
					if {_humidity} < 0.4:
						return minecraft:desert
					else:
						return beer:desert/lush_desert
			# Moderate erosion = forest/taiga mix
			else if {_erosion} > 0.3:
				if {_temp} < 0.2:
					return minecraft:snowy_taiga
				else if {_temp} < 0.4:
					if {_humidity} < 0.5:
						return minecraft:taiga
					else:
						return minecraft:snowy_taiga
				else if {_temp} < 0.6:
					if {_humidity} < 0.4:
						return beer:forest/dry_forest
					else if {_humidity} < 0.7:
						return minecraft:forest
					else:
						return beer:forest/tall_oak
				else if {_temp} < 0.8:
					if {_humidity} < 0.4:
						return minecraft:savanna
					else if {_humidity} < 0.7:
						return minecraft:jungle
					else:
						return beer:forest/lush_forest
				else:
					if {_humidity} < 0.4:
						return minecraft:desert
					else:
						return beer:desert/lush_desert
			# Low erosion = hilly near coast
			else:
				if {_temp} < 0.2:
					return minecraft:snowy_slopes
				else if {_temp} < 0.4:
					return minecraft:windswept_gravelly_hills
				else if {_temp} < 0.6:
					return minecraft:windswept_hills
				else if {_temp} < 0.8:
					return minecraft:windswept_savanna
				else:
					return minecraft:badlands

		# ==============================
		# MID INLAND (cont 0.70-0.85)
		# ==============================
		else if {_cont} < 0.85:
			# Valley floors
			if {_pv} < 0.25:
				if {_temp} < 0.2:
					return minecraft:frozen_river
				else if {_temp} > 0.6:
					if {_humidity} > 0.6:
						return minecraft:swamp
					else:
						return minecraft:river
				else:
					return minecraft:river
			# Plateau tops — moderate erosion + high PV = flat elevated terrain
			else if {_pv} > 0.75:
				if {_erosion} > 0.4:
					# Flat elevated plateau biomes
					if {_temp} < 0.2:
						return minecraft:snowy_plains
					else if {_temp} < 0.4:
						return minecraft:meadow
					else if {_temp} < 0.6:
						if {_humidity} < 0.5:
							return minecraft:meadow
						else:
							return minecraft:cherry_grove
					else if {_temp} < 0.8:
						if {_humidity} < 0.5:
							return minecraft:savanna_plateau
						else:
							return beer:forest/moss_garden
					else:
						if {_humidity} < 0.5:
							return minecraft:wooded_badlands
						else:
							return minecraft:badlands
			# High erosion = flat midlands
			else if {_erosion} > 0.6:
				if {_temp} < 0.2:
					return minecraft:snowy_plains
				else if {_temp} < 0.4:
					if {_humidity} > 0.5:
						return minecraft:snowy_taiga
					else:
						return beer:plains/cold_plains
				else if {_temp} < 0.6:
					if {_humidity} < 0.4:
						return minecraft:plains
					else if {_humidity} < 0.7:
						return minecraft:plains
					else:
						return minecraft:sunflower_plains
				else if {_temp} < 0.8:
					if {_humidity} < 0.4:
						return minecraft:savanna
					else:
						return minecraft:swamp
				else:
					return minecraft:desert
			# Moderate erosion = main biome zone
			else if {_erosion} > 0.3:
				if {_temp} < 0.2:
					if {_humidity} < 0.5:
						return minecraft:ice_spikes
					else:
						return minecraft:snowy_taiga
				else if {_temp} < 0.4:
					if {_humidity} < 0.4:
						return minecraft:taiga
					else:
						return minecraft:old_growth_spruce_taiga
				else if {_temp} < 0.6:
					if {_humidity} < 0.3:
						return beer:forest/dry_forest
					else if {_humidity} < 0.6:
						return minecraft:birch_forest
					else:
						return minecraft:old_growth_birch_forest
				else if {_temp} < 0.8:
					if {_humidity} < 0.3:
						return minecraft:sparse_jungle
					else if {_humidity} < 0.6:
						return minecraft:jungle
					else:
						return minecraft:bamboo_jungle
				else:
					if {_humidity} < 0.3:
						return minecraft:desert
					else if {_humidity} < 0.6:
						return beer:desert/dry_desert
					else:
						return beer:desert/lush_desert
			# Low erosion = hilly/mountainous mid inland
			else:
				if {_temp} < 0.2:
					if {_pv} > 0.6:
						return minecraft:frozen_peaks
					else:
						return minecraft:snowy_slopes
				else if {_temp} < 0.4:
					if {_pv} > 0.6:
						return minecraft:jagged_peaks
					else:
						return minecraft:windswept_gravelly_hills
				else if {_temp} < 0.6:
					if {_pv} > 0.6:
						return minecraft:stony_peaks
					else:
						return minecraft:windswept_forest
				else if {_temp} < 0.8:
					if {_pv} > 0.6:
						return minecraft:stony_peaks
					else:
						return minecraft:windswept_savanna
				else:
					return minecraft:badlands

		# ==============================
		# FAR INLAND (cont > 0.72)
		# ==============================
		else:
			# Valley floors
			if {_pv} < 0.25:
				if {_temp} < 0.2:
					return minecraft:frozen_river
				else if {_temp} > 0.6:
					if {_humidity} > 0.6:
						return minecraft:swamp
					else:
						return minecraft:river
				else:
					return minecraft:river
			# High peaks — tall mountains far inland
			else if {_pv} > 0.7:
				if {_erosion} < 0.4:
					if {_temp} < 0.2:
						return minecraft:frozen_peaks
					else if {_temp} < 0.4:
						return minecraft:jagged_peaks
					else if {_temp} < 0.8:
						return minecraft:stony_peaks
					else:
						return minecraft:badlands
			# High erosion = flat far inland (plateaus/plains)
			if {_erosion} > 0.6:
				if {_temp} < 0.2:
					return minecraft:snowy_plains
				else if {_temp} < 0.4:
					if {_humidity} > 0.5:
						return minecraft:snowy_taiga
					else:
						return minecraft:plains
				else if {_temp} < 0.6:
					if {_humidity} < 0.4:
						return minecraft:plains
					else:
						return minecraft:meadow
				else if {_temp} < 0.8:
					if {_humidity} < 0.4:
						return minecraft:savanna_plateau
					else:
						return minecraft:swamp
				else:
					if {_humidity} < 0.5:
						return minecraft:wooded_badlands
					else:
						return minecraft:badlands
			# Moderate erosion = highland forests
			else if {_erosion} > 0.3:
				if {_temp} < 0.2:
					if {_humidity} < 0.5:
						return minecraft:snowy_slopes
					else:
						return minecraft:grove
				else if {_temp} < 0.4:
					if {_humidity} < 0.4:
						return minecraft:taiga
					else:
						return minecraft:old_growth_pine_taiga
				else if {_temp} < 0.6:
					if {_humidity} < 0.4:
						return minecraft:forest
					else if {_humidity} < 0.7:
						return minecraft:dark_forest
					else:
						return beer:forest/moss_garden
				else if {_temp} < 0.8:
					if {_humidity} < 0.4:
						return minecraft:sparse_jungle
					else:
						return minecraft:jungle
				else:
					if {_humidity} < 0.4:
						return minecraft:desert
					else:
						return beer:desert/lush_desert
			# Low erosion = rugged mountains
			else:
				if {_temp} < 0.2:
					if {_pv} > 0.5:
						return minecraft:frozen_peaks
					else:
						return minecraft:snowy_slopes
				else if {_temp} < 0.4:
					if {_pv} > 0.5:
						return minecraft:jagged_peaks
					else:
						return minecraft:windswept_gravelly_hills
				else if {_temp} < 0.6:
					if {_pv} > 0.5:
						return minecraft:jagged_peaks
					else:
						return minecraft:windswept_forest
				else if {_temp} < 0.8:
					if {_pv} > 0.5:
						return minecraft:stony_peaks
					else:
						return minecraft:windswept_savanna
				else:
					return minecraft:eroded_badlands
		# Failsafe
		return minecraft:plains

register chunk generator with id "test_gen":
	vanilla caves: false
	vanilla decor: true
	vanilla structures: false
	noise gen:
		loop 16 times:
			loop 16 times:
				set {_x} to (loop-number-1) - 1
				set {_z} to (loop-number-2) - 1

				set {_worldX} to {_x} + (chunkdata chunk x * 16)
				set {_worldZ} to {_z} + (chunkdata chunk z * 16)

				set {_n} to block noise at {_worldX}, {_worldZ}

				set chunkdata blocks within vector({_x}, -64, {_z}) and vector({_x}, ({_n} - 1), {_z}) to stone[]
				if {_n} < 63:
					set chunkdata blocks within vector({_x}, {_n}, {_z}) and vector({_x}, 62, {_z}) to water[]
	height gen:
		set {_x} to x coord of event-location
		set {_z} to z coord of event-location
		set {_n} to block noise at {_x}, {_z}
		if {_n} > 62:
			set chunkdata height to {_n}
		else:
			set chunkdata height to 62
	biome gen:
		set {_x} to x coord of event-location
		set {_y} to y coord of event-location
		set {_z} to z coord of event-location
		if {-cache_biome::%{_x}%::%{_z}%} is set:
			set chunkdata biome to {-cache_biome::%{_x}%::%{_z}%}
			if {_y} >= 316:
				delete {-cache_biome::%{_x}%::%{_z}%}
			stop
		set {_cont} to continental noise at {_x}, {_z}
		set {_erosion} to erosion noise at {_x}, {_z}
		set {_pv} to pv noise at {_x}, {_z}
		set {_temp} to temperature noise at {_x}, {_z}
		set {_humidity} to humidity noise at {_x}, {_z}
		set {_biome} to noise biome with cont {_cont} and erosion {_erosion} and pv {_pv} and temp {_temp} and humidity {_humidity}
		set {-cache_biome::%{_x}%::%{_z}%} to {_biome}
		set chunkdata biome to {_biome}
